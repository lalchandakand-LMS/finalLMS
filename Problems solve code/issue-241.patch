diff --git a/app/Services/Plugins/PluginDiscoveryService.php b/app/Services/Plugins/PluginDiscoveryService.php
new file mode 100644
index 0000000..b83da6f
--- /dev/null
+++ b/app/Services/Plugins/PluginDiscoveryService.php
@@ -0,0 +1,148 @@
+<?php
+
+namespace App\Services\Plugins;
+
+use App\Models\PluginInstallation;
+use RuntimeException;
+
+final class PluginDiscoveryService
+{
+    public function __construct(private readonly PluginManifestValidator $manifestValidator)
+    {
+    }
+
+    /**
+     * Safely inspect private plugins/<vendor>/<slug>/<version>/plugin.json manifests without
+     * executing any plugin PHP code or auto-activating discovered packages.
+     *
+     * @return array{scanned: int, discovered: int, already_registered: int, skipped: list<array{path: string, reason: string}>}
+     */
+    public function discover(): array
+    {
+        $pluginsRootPath = base_path('plugins');
+        if (is_link($pluginsRootPath)) {
+            throw new RuntimeException('The private plugins directory must not be a symbolic link.');
+        }
+
+        $pluginsRoot = realpath($pluginsRootPath);
+        if ($pluginsRoot === false || ! is_dir($pluginsRoot)) {
+            return ['scanned' => 0, 'discovered' => 0, 'already_registered' => 0, 'skipped' => []];
+        }
+
+        $scanned = 0;
+        $discovered = 0;
+        $alreadyRegistered = 0;
+        $skipped = [];
+
+        foreach ($this->childDirectories($pluginsRoot) as $vendorDir) {
+            $vendor = basename($vendorDir);
+            if (str_starts_with($vendor, '.')) {
+                continue;
+            }
+
+            foreach ($this->childDirectories($vendorDir) as $slugDir) {
+                $slug = basename($slugDir);
+                if (str_starts_with($slug, '.')) {
+                    continue;
+                }
+
+                foreach ($this->childDirectories($slugDir) as $versionDir) {
+                    $version = basename($versionDir);
+                    $manifestPath = $versionDir.DIRECTORY_SEPARATOR.'plugin.json';
+                    $relativePackagePath = 'plugins/'.$vendor.'/'.$slug.'/'.$version;
+
+                    if (is_link($manifestPath) || ! is_file($manifestPath)) {
+                        continue;
+                    }
+
+                    $scanned++;
+                    $realManifest = realpath($manifestPath);
+                    if ($realManifest === false
+                        || ! str_starts_with($realManifest, rtrim($pluginsRoot, DIRECTORY_SEPARATOR).DIRECTORY_SEPARATOR)) {
+                        $skipped[] = ['path' => $relativePackagePath, 'reason' => 'Manifest resolves outside private plugins directory.'];
+                        continue;
+                    }
+
+                    try {
+                        $manifest = json_decode((string) file_get_contents($realManifest), true, 64, JSON_THROW_ON_ERROR);
+                    } catch (\JsonException) {
+                        $skipped[] = ['path' => $relativePackagePath, 'reason' => 'Malformed plugin.json.'];
+                        continue;
+                    }
+
+                    if (! is_array($manifest) || array_is_list($manifest)) {
+                        $skipped[] = ['path' => $relativePackagePath, 'reason' => 'Manifest must be a JSON object.'];
+                        continue;
+                    }
+
+                    $errors = $this->manifestValidator->errors($manifest);
+                    if ($errors !== []) {
+                        $skipped[] = ['path' => $relativePackagePath, 'reason' => implode(' ', $errors)];
+                        continue;
+                    }
+
+                    [$manifestVendor, $manifestSlug] = explode('.', (string) $manifest['key'], 2);
+                    $expectedRelative = 'plugins/'.$manifestVendor.'/'.str_replace('.', '-', $manifestSlug).'/'.$manifest['version'];
+                    if (! hash_equals($expectedRelative, $relativePackagePath)) {
+                        $skipped[] = ['path' => $relativePackagePath, 'reason' => 'Directory path does not match canonical manifest key/version.'];
+                        continue;
+                    }
+
+                    $existing = PluginInstallation::query()->where('plugin_key', (string) $manifest['key'])->first();
+                    if ($existing) {
+                        $alreadyRegistered++;
+                        continue;
+                    }
+
+                    $plugin = new PluginInstallation();
+                    $plugin->forceFill([
+                        'plugin_key' => (string) $manifest['key'],
+                        'name' => (string) $manifest['name'],
+                        'version' => (string) $manifest['version'],
+                        'type' => (string) $manifest['type'],
+                        'status' => 'discovered',
+                        'manifest' => $manifest,
+                        'package_path' => $expectedRelative,
+                        'health_status' => 'unknown',
+                        'health_message' => 'Discovered in private plugins directory. Upload a signed package archive before activation.',
+                    ])->save();
+
+                    $discovered++;
+                }
+            }
+        }
+
+        return [
+            'scanned' => $scanned,
+            'discovered' => $discovered,
+            'already_registered' => $alreadyRegistered,
+            'skipped' => $skipped,
+        ];
+    }
+
+    /**
+     * @return list<string>
+     */
+    private function childDirectories(string $parent): array
+    {
+        $entries = @scandir($parent);
+        if (! is_array($entries)) {
+            return [];
+        }
+
+        $dirs = [];
+        foreach ($entries as $entry) {
+            if ($entry === '.' || $entry === '..') {
+                continue;
+            }
+            $full = $parent.DIRECTORY_SEPARATOR.$entry;
+            if (! is_link($full) && is_dir($full)) {
+                $dirs[] = $full;
+            }
+        }
+
+        sort($dirs, SORT_STRING);
+
+        return $dirs;
+    }
+}
diff --git a/app/Services/Plugins/PluginHealthChecker.php b/app/Services/Plugins/PluginHealthChecker.php
new file mode 100644
index 0000000..1a12816
--- /dev/null
+++ b/app/Services/Plugins/PluginHealthChecker.php
@@ -0,0 +1,115 @@
+<?php
+
+namespace App\Services\Plugins;
+
+use App\Models\PluginInstallation;
+use Illuminate\Support\Facades\DB;
+use Throwable;
+
+final class PluginHealthChecker
+{
+    public function __construct(
+        private readonly PluginManifestValidator $manifestValidator,
+        private readonly PluginCompatibilityChecker $compatibilityChecker,
+        private readonly PluginIntegrityVerifier $integrityVerifier,
+    ) {
+    }
+
+    /**
+     * Evaluate signature trust, compatibility, dependencies, integrity, and migration status,
+     * persisting health_status, health_message, and last_health_check_at.
+     *
+     * @return array{status: string, message: string, issues: list<string>, warnings: list<string>}
+     */
+    public function checkAndRecord(PluginInstallation $plugin): array
+    {
+        $issues = [];
+        $warnings = [];
+
+        if ($plugin->status === 'uninstalled') {
+            $status = 'unknown';
+            $message = 'Plugin package is uninstalled; historical data and migration logs are preserved.';
+            $plugin->forceFill([
+                'health_status' => $status,
+                'health_message' => $message,
+                'last_health_check_at' => now(),
+            ])->save();
+
+            return ['status' => $status, 'message' => $message, 'issues' => [], 'warnings' => []];
+        }
+
+        if ($plugin->status === 'discovered') {
+            $warnings[] = 'Package discovered on disk; upload a signed ZIP archive before activation.';
+        } else {
+            $trustedKeys = config('plugins.trusted_public_keys', []);
+            if ($plugin->signature_verified_at === null
+                || ! is_string($plugin->signature_key_id)
+                || ! is_array($trustedKeys)
+                || ! array_key_exists($plugin->signature_key_id, $trustedKeys)) {
+                $issues[] = 'Release signing key is missing or no longer trusted.';
+            }
+        }
+
+        $manifestErrors = $this->manifestValidator->errors($plugin->manifest ?? []);
+        if ($manifestErrors !== []) {
+            $issues[] = 'Invalid manifest: '.implode(' ', $manifestErrors);
+        } else {
+            $compat = $this->compatibilityChecker->check($plugin->manifest ?? []);
+            if (! $compat['compatible']) {
+                $issues[] = 'Compatibility failed: '.implode(' ', $compat['errors']);
+            }
+        }
+
+        foreach (($plugin->manifest['dependencies'] ?? []) as $dependency) {
+            if (! PluginInstallation::query()->where('plugin_key', $dependency)->where('status', 'active')->exists()) {
+                $warnings[] = 'Required dependency is not active: '.$dependency;
+            }
+        }
+
+        foreach (($plugin->manifest['conflicts'] ?? []) as $conflict) {
+            if (PluginInstallation::query()->where('plugin_key', $conflict)->where('status', 'active')->exists()) {
+                $issues[] = 'Conflicting plugin is active: '.$conflict;
+            }
+        }
+
+        if (in_array($plugin->status, ['installed', 'active', 'inactive'], true)) {
+            try {
+                $this->integrityVerifier->verify($plugin);
+            } catch (Throwable $exception) {
+                $issues[] = $exception->getMessage();
+            }
+        }
+
+        $failedMigrations = DB::table('plugin_migrations')
+            ->where('plugin_key', $plugin->plugin_key)
+            ->where('status', 'failed')
+            ->count();
+        if ($failedMigrations > 0) {
+            $warnings[] = sprintf('%d plugin migration(s) previously failed.', $failedMigrations);
+        }
+
+        if ($issues !== []) {
+            $status = 'failed';
+            $message = implode(' ', $issues);
+        } elseif ($warnings !== []) {
+            $status = 'degraded';
+            $message = implode(' ', $warnings);
+        } else {
+            $status = 'healthy';
+            $message = 'All signature, compatibility, dependency, integrity, and migration checks passed.';
+        }
+
+        $plugin->forceFill([
+            'health_status' => $status,
+            'health_message' => mb_substr($message, 0, 1000),
+            'last_health_check_at' => now(),
+        ])->save();
+
+        return [
+            'status' => $status,
+            'message' => $message,
+            'issues' => $issues,
+            'warnings' => $warnings,
+        ];
+    }
+}
diff --git a/app/Services/Plugins/PluginHookRegistry.php b/app/Services/Plugins/PluginHookRegistry.php
new file mode 100644
index 0000000..2fc17b7
--- /dev/null
+++ b/app/Services/Plugins/PluginHookRegistry.php
@@ -0,0 +1,203 @@
+<?php
+
+namespace App\Services\Plugins;
+
+use App\Models\PluginInstallation;
+use Illuminate\Support\Facades\Route;
+use Illuminate\Support\Facades\Schema;
+use InvalidArgumentException;
+use Throwable;
+
+final class PluginHookRegistry
+{
+    /** @var array<string, list<array{plugin_key: string, priority: int, callback: callable}>> */
+    private array $hooks = [];
+
+    /** @var array<string, list<array{plugin_key: string, label: string, route: string, icon: string, permission: ?string}>> */
+    private array $portalNav = [];
+
+    /** @var array<string, list<string>> */
+    private array $capabilities = [];
+
+    public function registerHook(string $pluginKey, string $hook, callable $callback, int $priority = 10): void
+    {
+        if (preg_match('/^[a-z0-9][a-z0-9_.-]{1,120}$/D', $hook) !== 1) {
+            throw new InvalidArgumentException('Invalid plugin hook identifier.');
+        }
+
+        $this->hooks[$hook][] = [
+            'plugin_key' => $pluginKey,
+            'priority' => $priority,
+            'callback' => $callback,
+        ];
+    }
+
+    /**
+     * @param  array{icon?: string, permission?: ?string}  $options
+     */
+    public function registerPortalNavigation(
+        string $pluginKey,
+        string $portal,
+        string $label,
+        string $routeName,
+        array $options = [],
+    ): void {
+        if (trim($label) === '' || preg_match('/^[a-z][a-z0-9_.-]{1,120}$/D', $routeName) !== 1) {
+            throw new InvalidArgumentException('Invalid plugin navigation registration.');
+        }
+
+        $this->portalNav[$portal][] = [
+            'plugin_key' => $pluginKey,
+            'label' => mb_substr(trim($label), 0, 80),
+            'route' => $routeName,
+            'icon' => mb_substr((string) ($options['icon'] ?? '🧩'), 0, 16),
+            'permission' => isset($options['permission']) && is_string($options['permission'])
+                ? $options['permission']
+                : null,
+        ];
+    }
+
+    /**
+     * @param  list<string>  $capabilities
+     */
+    public function registerCapabilities(string $pluginKey, array $capabilities): void
+    {
+        $clean = [];
+        foreach ($capabilities as $capability) {
+            if (is_string($capability) && trim($capability) !== '') {
+                $clean[] = trim($capability);
+            }
+        }
+        $this->capabilities[$pluginKey] = array_values(array_unique($clean));
+    }
+
+    /**
+     * Execute hooks registered by currently active, signature-verified plugins.
+     *
+     * @param  array<string, mixed>  $payload
+     * @return list<mixed>
+     */
+    public function dispatch(string $hook, array $payload = []): array
+    {
+        $entries = $this->hooks[$hook] ?? [];
+        if ($entries === []) {
+            return [];
+        }
+
+        usort($entries, static fn (array $a, array $b): int => $a['priority'] <=> $b['priority']);
+
+        $activeKeys = $this->activeVerifiedPlugins();
+        $results = [];
+
+        foreach ($entries as $entry) {
+            if (! isset($activeKeys[$entry['plugin_key']])) {
+                continue;
+            }
+
+            try {
+                $value = ($entry['callback'])($payload);
+                if ($value !== null) {
+                    $results[] = $value;
+                }
+            } catch (Throwable $exception) {
+                report($exception);
+            }
+        }
+
+        return $results;
+    }
+
+    /**
+     * Return navigation links for a given portal belonging strictly to currently active plugins.
+     *
+     * @return list<array{plugin_key: string, label: string, route: string, icon: string, permission: ?string}>
+     */
+    public function portalNavigation(string $portal): array
+    {
+        $items = $this->portalNav[$portal] ?? [];
+        if ($items === []) {
+            return [];
+        }
+
+        $activePlugins = $this->activeVerifiedPlugins();
+        $visible = [];
+
+        foreach ($items as $item) {
+            $plugin = $activePlugins[$item['plugin_key']] ?? null;
+            if (! $plugin instanceof PluginInstallation) {
+                continue;
+            }
+
+            if (! in_array($portal, $plugin->manifest['portals'] ?? [], true)) {
+                continue;
+            }
+
+            if (! Route::has($item['route'])) {
+                continue;
+            }
+
+            $visible[] = $item;
+        }
+
+        return $visible;
+    }
+
+    public function hasCapability(string $capability): bool
+    {
+        return $this->pluginsWithCapability($capability) !== [];
+    }
+
+    /**
+     * @return list<string>
+     */
+    public function pluginsWithCapability(string $capability): array
+    {
+        $activeKeys = $this->activeVerifiedPlugins();
+        $matched = [];
+
+        foreach ($this->capabilities as $pluginKey => $caps) {
+            if (isset($activeKeys[$pluginKey]) && in_array($capability, $caps, true)) {
+                $matched[] = $pluginKey;
+            }
+        }
+
+        return $matched;
+    }
+
+    public function reset(): void
+    {
+        $this->hooks = [];
+        $this->portalNav = [];
+        $this->capabilities = [];
+    }
+
+    /**
+     * @return array<string, PluginInstallation>
+     */
+    private function activeVerifiedPlugins(): array
+    {
+        try {
+            if (! Schema::hasTable('plugin_registry')) {
+                return [];
+            }
+        } catch (Throwable) {
+            return [];
+        }
+
+        $trustedKeys = config('plugins.trusted_public_keys', []);
+        if (! is_array($trustedKeys)) {
+            return [];
+        }
+
+        $active = [];
+        foreach (PluginInstallation::query()->where('status', 'active')->get() as $plugin) {
+            if ($plugin->signature_verified_at !== null
+                && is_string($plugin->signature_key_id)
+                && array_key_exists($plugin->signature_key_id, $trustedKeys)) {
+                $active[$plugin->plugin_key] = $plugin;
+            }
+        }
+
+        return $active;
+    }
+}
