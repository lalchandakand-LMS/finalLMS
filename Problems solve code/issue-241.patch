+    /**
+     * Extract a signature-verified update package into its canonical versioned directory.
+     *
+     * @param  array<string, mixed>  $manifest
+     * @return array<string, string>
+     */
+    public function extractVerifiedUpdatePackage(
+        string $pluginKey,
+        array $manifest,
+        string $expectedChecksum,
+        string $finalRelativePath,
+        string $stagedArchivePath,
+    ): array {
+        if (! class_exists(ZipArchive::class)) {
+            throw new RuntimeException('The PHP zip extension is required for plugin installation.');
+        }
+
+        $archive = $this->resolveStagedArchive($stagedArchivePath);
+        $maxPackageBytes = max(1, (int) config('plugins.max_package_bytes', 52428800));
+        $archiveSize = filesize($archive);
+        if ($archiveSize === false || $archiveSize < 1 || $archiveSize > $maxPackageBytes) {
+            throw new RuntimeException('The staged plugin archive is empty or exceeds the configured package limit.');
+        }
+
+        $checksum = hash_file('sha256', $archive);
+        if (! is_string($checksum) || ! hash_equals($expectedChecksum, $checksum)) {
+            throw new RuntimeException('The staged plugin archive checksum does not match its verified signature.');
+        }
+
+        $parts = explode('.', $pluginKey, 2);
+        if (count($parts) !== 2) {
+            throw new RuntimeException('Invalid plugin identity.');
+        }
+        $expectedPath = 'plugins/'.$parts[0].'/'.str_replace('.', '-', $parts[1]).'/'.$manifest['version'];
+        if (! hash_equals($expectedPath, $finalRelativePath)) {
+            throw new RuntimeException('The plugin update destination does not match its signed identity.');
+        }
+
+        $pluginsRoot = realpath(base_path('plugins'));
+        if ($pluginsRoot === false || is_link(base_path('plugins'))) {
+            throw new RuntimeException('The private plugins directory is unavailable or unsafe.');
+        }
+
+        $finalAbsolutePath = $pluginsRoot.DIRECTORY_SEPARATOR.$parts[0].DIRECTORY_SEPARATOR.str_replace('.', '-', $parts[1]).DIRECTORY_SEPARATOR.$manifest['version'];
+        if (file_exists($finalAbsolutePath) || is_link($finalAbsolutePath)) {
+            throw new RuntimeException('The target plugin version already exists on disk; update aborted.');
+        }
+
+        $stagingRoot = realpath((string) config('plugins.staging_directory'));
+        if ($stagingRoot === false) {
+            throw new RuntimeException('The private plugin staging directory is unavailable.');
+        }
+
+        $extractDirectory = $stagingRoot.DIRECTORY_SEPARATOR.'extract-update-'.bin2hex(random_bytes(16));
+        if (! mkdir($extractDirectory, 0700)) {
+            throw new RuntimeException('Unable to create a private plugin update extraction directory.');
+        }
+
+        $zip = new ZipArchive();
+        if ($zip->open($archive, ZipArchive::RDONLY) !== true) {
+            File::deleteDirectory($extractDirectory);
+            throw new RuntimeException('The staged plugin archive is not a readable ZIP file.');
+        }
+
+        try {
+            $entries = $this->inspectArchive($zip);
+            $fileHashes = $this->extractEntries($zip, $entries, $extractDirectory);
+            $postExtractionChecksum = hash_file('sha256', $archive);
+            if (! is_string($postExtractionChecksum) || ! hash_equals($checksum, $postExtractionChecksum)) {
+                throw new RuntimeException('The staged plugin archive changed during extraction.');
+            }
+
+            $entrypoint = $extractDirectory.DIRECTORY_SEPARATOR.str_replace('/', DIRECTORY_SEPARATOR, (string) $manifest['entrypoint']);
+            if (! is_file($entrypoint) || is_link($entrypoint)) {
+                throw new RuntimeException('The signed plugin entrypoint is missing from the update package.');
+            }
+
+            $this->ensurePrivateParentDirectory(dirname($finalAbsolutePath));
+            if (file_exists($finalAbsolutePath) || is_link($finalAbsolutePath)) {
+                throw new RuntimeException('The target plugin version appeared during extraction.');
+            }
+
+            if (! rename($extractDirectory, $finalAbsolutePath)) {
+                throw new RuntimeException('Unable to atomically move the verified plugin update into its private directory.');
+            }
+
+            return $fileHashes;
+        } catch (\Throwable $exception) {
