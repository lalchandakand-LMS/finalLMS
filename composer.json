{
  "name": "aloms/english-center-lms",
  "type": "project",
  "description": "Aloms English Center commercial LMS",
  "keywords": ["lms", "education", "laravel"],
  "license": "proprietary",
  "require": {"php": "^8.3", "laravel/framework": "^12.0", "laravel/tinker": "^2.10"},
  "require-dev": {"phpunit/phpunit": "^11.0", "fakerphp/faker": "^1.23", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.6"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": ["@php artisan test"], "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "post-create-project-cmd": ["@php artisan key:generate --ansi"]},
  "config": {"platform": {"php": "8.3.0"}, "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
  "minimum-stability": "stable", "prefer-stable": true
}
