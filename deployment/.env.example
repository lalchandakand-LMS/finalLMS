APP_NAME="Alom's English Center LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_INSTALLED=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_with_cpanel_database
DB_USERNAME=replace_with_cpanel_user
DB_PASSWORD=replace_with_a_strong_secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=replace_with_smtp_host
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.example
MAIL_FROM_NAME="Alom's English Center"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

VITE_APP_NAME="Alom's English Center LMS"

# bKash Tokenized Checkout (keep merchant credentials out of Git)
BKASH_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_VERIFY_SSL=true

# Nagad: configuration only until official merchant API documentation is supplied
NAGAD_ENABLED=false
NAGAD_MODE=sandbox
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY_PATH=storage/app/secure/nagad-merchant-private.pem
NAGAD_GATEWAY_PUBLIC_KEY_PATH=storage/app/secure/nagad-gateway-public.pem


# AI Developer (optional; configure only on the server, never commit real credentials)
AI_DEVELOPER_PROVIDER=openai-compatible
AI_DEVELOPER_BASE_URL=https://api.openai.com/v1
AI_DEVELOPER_ALLOWED_HOSTS=api.openai.com
AI_DEVELOPER_API_KEY=
AI_DEVELOPER_MODEL=
