{
  "schema_version": 1,
  "key": "website_cms",
  "name": "Website CMS",
  "description": "Website builder, pages, blog and public content.",
  "type": "first_party",
  "status": "metadata_only",
  "provider": null,
  "dependencies": [
    "core"
  ],
  "permissions": [],
  "routes": [
    "landing",
    "pages.*",
    "website-pages.*",
    "news.*",
