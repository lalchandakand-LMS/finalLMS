{
  "schema_version": 1,
  "key": "student_portal",
  "name": "Student Portal",
  "description": "Student dashboard, learning progress and self-service.",
  "type": "first_party",
  "status": "metadata_only",
  "provider": null,
  "dependencies": [
    "core",
    "identity",
    "student_management",
    "course_management"
  ],
  "permissions": [],
  "routes": [
    "student.dashboard.*",
    "student.profile.*",
    "student.wishlist.*",
    "student.courses.*",
    "student.invoices.print",
    "student.invoices.receipts.print"
  ],
  "settings": [],
  "events": [],
  "directory": "plugins/student_portal",
  "safety": {
    "trusted_code_only": true,
    "execute_uploaded_code": false,
    "disable_preserves_data": true
  }
}
