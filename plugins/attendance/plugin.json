{
  "schema_version": 1,
  "key": "attendance",
  "name": "Attendance",
  "description": "Online and offline-first student attendance, session check-in, reconciliation and authorized attendance reporting.",
  "type": "first_party",
  "status": "metadata_only",
  "provider": null,
  "dependencies": [
    "core",
    "identity",
    "branch_management",
    "student_management",
    "academic_levels"
  ],
  "permissions": [
    "attendance.view",
    "attendance.mark",
    "attendance.edit",
    "attendance.sync",
    "attendance.resolve_conflicts",
    "attendance.export",
    "attendance.manage_settings"
  ],
  "portals": [
    "admin",
    "branch",
    "teacher",
    "student",
    "guardian"
  ],
  "routes": [
    "teacher.batches.attendance.*",
    "student.attendance.*",
    "admin.attendance.*",
    "admin.batches.attendance.*",
    "branch.attendance.*"
  ],
  "api_routes": [
    "api.v1.plugins.aec.attendance.*"
  ],
  "settings": [
    "offline_sync_enabled",
    "offline_record_retention_hours",
    "attendance_edit_window_hours",
    "qr_checkin_enabled",
    "geofence_enabled"
  ],
  "events": [
    "attendance.session.created",
    "attendance.recorded",
    "attendance.record.updated",
    "attendance.offline_sync.accepted",
    "attendance.offline_sync.conflict"
  ],
  "directory": "plugins/attendance",
  "capabilities": [
    "online_manual_roster",
    "offline_first_roster",
    "idempotent_sync",
    "conflict_resolution",
    "short_lived_qr_checkin"
  ],
  "safety": {
    "trusted_code_only": true,
    "execute_uploaded_code": false,
    "disable_preserves_data": true,
    "server_is_source_of_truth": true,
    "offline_records_provisional_until_synced": true,
    "geofence_default_off": true,
    "no_covert_location_tracking": true
  }
}
