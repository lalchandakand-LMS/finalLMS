{
  "schema_version": 1,
  "key": "attendance",
  "name": "Attendance",
  "description": "Online and offline-first student attendance. Planned capabilities include manual roster marking, authenticated offline sync, idempotency, conflict resolution and optional short-lived QR check-in.",
  "type": "first_party",
  "status": "metadata_only",
  "provider": null,
  "dependencies": [
    "core",
    "identity",
    "branch_management",
    "student_management",
    "academic_levels"
  ],
  "permissions": [],
  "routes": [
    "teacher.batches.attendance.*",
    "student.attendance.*",
    "admin.attendance.*",
    "admin.batches.attendance.*",
    "branch.attendance.*"
  ],
  "settings": [],
  "events": [],
  "directory": "plugins/attendance",
  "planned_capabilities": [
    "online_manual_roster",
    "offline_first_roster",
    "idempotent_sync",
    "conflict_resolution",
    "short_lived_qr_checkin"
  ],
  "safety": {
    "trusted_code_only": true,
    "execute_uploaded_code": false,
    "disable_preserves_data": true,
    "server_is_source_of_truth": true,
    "offline_records_provisional_until_synced": true,
    "geofence_default_off": true,
    "no_covert_location_tracking": true
  }
}
