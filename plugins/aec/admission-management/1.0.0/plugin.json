{
  "schema_version": 1,
  "key": "aec.admission-management",
  "name": "Admission Management",
  "version": "1.0.0",
  "type": "module",
  "entrypoint": "src/Plugin.php",
  "requires": {
    "php": "^8.3",
    "laravel": "^12.0",
    "lms": "^1.0"
  },
  "dependencies": [],
  "conflicts": [],
  "portals": [
    "admin",
    "branch",
    "public"
  ],
  "permissions": [
    "admissions.manage"
  ],
  "capabilities": [
    "public-admission-intake",
    "application-tracking-by-code-and-email",
    "branch-scoped-review",
    "screening-and-interview-workflow",
    "private-admission-document-storage",
    "idempotent-student-account-conversion",
    "typed-online-document-upload",
    "document-verification-and-correction-workflow",
    "application-audit-timeline",
    "branch-scoped-admission-analytics",
    "filtered-admission-csv-export",
    "walk-in-admission-registration"
  ],
  "migrations": "migrations",
  "settings_schema": {
    "intake_status": {
      "label": "Admission intake status",
      "type": "select",
      "options": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "admission_fee_bdt": {
      "label": "Default admission fee (BDT)",
      "type": "integer",
      "default": 0
    }
  }
}
